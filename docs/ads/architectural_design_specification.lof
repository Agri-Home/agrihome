\contentsline {figure}{\numberline {1}{\ignorespaces AgriHome Vision Console: five-layer architecture with Pi/Klipper edge trust boundaries.}}{13}{figure.1}%
\contentsline {figure}{\numberline {2}{\ignorespaces Subsystem definitions and primary data flow (edge hardware talks to the application layer; application also reads/writes the data layer directly for most CRUD paths).}}{15}{figure.2}%
\contentsline {figure}{\numberline {3}{\ignorespaces Write coordination subsystem: accepts write intents and forwards them toward integrity checks.}}{17}{figure.3}%
\contentsline {figure}{\numberline {4}{\ignorespaces Integrity subsystem: validates operations before execution.}}{17}{figure.4}%
\contentsline {figure}{\numberline {5}{\ignorespaces Query executor: issues SQL and coordinates binary I/O with storage.}}{18}{figure.5}%
\contentsline {figure}{\numberline {6}{\ignorespaces PostgreSQL domain database subsystem (includes edge device and pose tables).}}{19}{figure.6}%
\contentsline {figure}{\numberline {7}{\ignorespaces Edge domain persistence: relational edge tables plus capture binaries.}}{20}{figure.7}%
\contentsline {figure}{\numberline {8}{\ignorespaces Image and media storage subsystem and relationship to application reads.}}{20}{figure.8}%
\contentsline {figure}{\numberline {9}{\ignorespaces Authentication UI: user actions become authenticated API calls.}}{22}{figure.9}%
\contentsline {figure}{\numberline {10}{\ignorespaces Dashboard subsystem requests summary aggregates from the application tier.}}{22}{figure.10}%
\contentsline {figure}{\numberline {11}{\ignorespaces Tray console: drives reads and optional vision requests through the application layer.}}{23}{figure.11}%
\contentsline {figure}{\numberline {12}{\ignorespaces Plant detail subsystem: CRUD and reporting views.}}{24}{figure.12}%
\contentsline {figure}{\numberline {13}{\ignorespaces Mesh subsystem interacts with mesh and member tray aggregates.}}{24}{figure.13}%
\contentsline {figure}{\numberline {14}{\ignorespaces Schedule subsystem persists policies via application APIs.}}{25}{figure.14}%
\contentsline {figure}{\numberline {15}{\ignorespaces Devices UI: operator fleet view over edge device APIs.}}{25}{figure.15}%
\contentsline {figure}{\numberline {16}{\ignorespaces Tray Pi panel: Take Picture and Klipper URL management via devices API.}}{26}{figure.16}%
\contentsline {figure}{\numberline {17}{\ignorespaces API entry: first server hop after the presentation layer.}}{27}{figure.17}%
\contentsline {figure}{\numberline {18}{\ignorespaces Session broker: establishes trusted account context for downstream work.}}{28}{figure.18}%
\contentsline {figure}{\numberline {19}{\ignorespaces Validation subsystem: rejects bad input early.}}{28}{figure.19}%
\contentsline {figure}{\numberline {20}{\ignorespaces Domain orchestration: central business logic and integration point.}}{29}{figure.20}%
\contentsline {figure}{\numberline {21}{\ignorespaces GraphQL facade: thin mapping to domain services.}}{29}{figure.21}%
\contentsline {figure}{\numberline {22}{\ignorespaces Response handler: maps internal results to HTTP/GraphQL responses.}}{30}{figure.22}%
\contentsline {figure}{\numberline {23}{\ignorespaces Raspberry Pi edge API: device-key routes into domain persistence.}}{31}{figure.23}%
\contentsline {figure}{\numberline {24}{\ignorespaces Operator devices API: Take Picture and device administration.}}{31}{figure.24}%
\contentsline {figure}{\numberline {25}{\ignorespaces Species inference adapter: hosted model runtime may be external.}}{33}{figure.25}%
\contentsline {figure}{\numberline {26}{\ignorespaces Tray vision adapter: round-trip inference for tray imagery.}}{33}{figure.26}%
\contentsline {figure}{\numberline {27}{\ignorespaces Normalization: single canonical shape for downstream persistence.}}{34}{figure.27}%
\contentsline {figure}{\numberline {28}{\ignorespaces Edge disease hook: optional classification after Pi capture.}}{35}{figure.28}%
\contentsline {figure}{\numberline {29}{\ignorespaces Capture schedule runner: enqueues edge capture work for agents.}}{35}{figure.29}%
\contentsline {figure}{\numberline {30}{\ignorespaces Pi edge host: register and heartbeat against AgriHome.}}{37}{figure.30}%
\contentsline {figure}{\numberline {31}{\ignorespaces Primary fswebcam capture on the agent; optional server-side HTTP streamer still.}}{38}{figure.31}%
\contentsline {figure}{\numberline {32}{\ignorespaces Edge agent bridges Klipper/fswebcam local capture to AgriHome APIs.}}{38}{figure.32}%
